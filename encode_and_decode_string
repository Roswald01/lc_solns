-- Encode: Time O(n), Space  O(n)
-- Decode: Time  O(n), Space O(n)

class Solution {
public:

    string encode(vector<string>& strs) {
        string res = "";
        for(int i = 0; i < strs.size(); i++){
            res += to_string(strs[i].size()) + "#" + strs[i];
        }
        return res;
    }

    vector<string> decode(string s) {
        vector<string> ans;
        int i = 0;

        while(i < s.size()) {

            string num = "";

            // Read the length until #
            while(s[i] != '#') {
                num += s[i];
                i++;
            }

            int countWord = stoi(num);

            // Skip #
            i++;

            string word = "";

            // Extract exactly countWord characters
            for(int j = 0; j < countWord; j++) {
                word += s[i];
                i++;
            }

            ans.push_back(word);
        }

        return ans;
    }
};
